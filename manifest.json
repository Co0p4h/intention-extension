{
  "name": "reflection",
  "version": "1.0",
  "manifest_version": 3,
  "description": "you are a goldfish",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "images/icon-16.png"
  },
  "icons": {
    "16": "images/icon-16.png"
  },
  "content_scripts": [
    {
      "run_at": "document_start",
      "matches": [
        "*://www.instagram.com/*",
        "*://www.youtube.com/*",
        "*://www.youtube.com/watch*",
        "*://www.youtube.com/shorts/*",
        "*://www.twitch.tv/*"
      ],
      "js": [
        "scripts/content-script.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "*.html",
        "images/*.webp",
        "scripts/*.js"
      ],
      "matches": [
        "*://*.instagram.com/*",
        "*://*.youtube.com/*",
        "*://*.twitch.tv/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}