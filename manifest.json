{
  "name": "Intention",
  "version": "1.0",
  "manifest_version": 3,
  "description": "consume content with more intention",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://www.youtube.com/watch*",
    "*://www.twitch.tv/*"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "128": "images/icon-128.png"
  },
  "content_scripts": [
    {
      "run_at": "document_start",
      "exlude_matches": [
        "*://www.youtube.com/shorts*"
      ],
      "matches": [
        "*://www.youtube.com/*",
        "*://www.youtube.com/watch*",
        "*://www.twitch.tv/*"
      ],
      "js": [
        "scripts/content-script.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pages/*.html",
        "images/*.webp",
        "scripts/*.js"
      ],
      "matches": [
        "*://*.youtube.com/*",
        "*://*.twitch.tv/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}